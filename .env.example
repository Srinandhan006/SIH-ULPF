# Copy to .env and adjust. Everything is optional — sane defaults ship for the local demo.
ULI_MODE=local
ULI_DATA_DIR=./data
ULI_LOG_LEVEL=INFO
ULI_LOG_JSON=true

# Storage: leave blank for SQLite under ULI_DATA_DIR; or set a PostgreSQL URL for production.
ULI_DB_URL=

# Queue: auto tries Redis then falls back to in-process memory (single-container demo).
ULI_QUEUE_BACKEND=auto
ULI_REDIS_URL=redis://redis:6379/0

# Auth: "none" for the demo (single default tenant); "static" + ULI_API_KEYS for real deployments.
ULI_AUTH=none
ULI_API_KEYS=

# ML sidecar (optional — see docs/ml-strategy.md).
ULI_ML_ENABLED=false
ULI_ML_URL=http://ml:8090

# API
ULI_API_PORT=8080
