# Multi-stage, distroless-style runtime, non-root, air-gap friendly (all deps baked in at build time).
FROM python:3.12-slim AS builder
WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip
COPY pyproject.toml README.md ./
COPY uli ./uli
RUN pip install --no-cache-dir --prefix=/install .

# Builds the React console from source -- no host-side `npm run build` step needed, so a fresh
# clone can `docker compose build` standalone. Needs network for `npm ci` (same one-time,
# build-only network dependency the Python/Go images already have); nothing here runs at container
# start, so this doesn't affect the air-gapped runtime story.
FROM node:22-alpine AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
RUN groupadd -r uli && useradd -r -g uli -d /app uli \
    && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /install /usr/local
WORKDIR /app
COPY uli ./uli
COPY schemas ./schemas
COPY parsers ./parsers
COPY pyproject.toml README.md ./
# Pre-built React UI (built in the ui-builder stage above) so FastAPI can serve it at /ui
COPY --from=ui-builder /ui/dist ./ui/dist
RUN mkdir -p /app/data /app/models && chown -R uli:uli /app
USER uli
ENV ULI_DATA_DIR=/app/data ULI_PARSERS_DIR=/app/parsers ULI_SCHEMAS_DIR=/app/schemas
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 CMD curl -sf http://localhost:8080/health || exit 1
CMD ["python", "-m", "uvicorn", "uli.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
