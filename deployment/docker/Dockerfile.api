# Multi-stage, distroless-style runtime, non-root, air-gap friendly (all deps baked in at build time).
FROM python:3.12-slim AS builder
WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip
COPY pyproject.toml README.md ./
COPY uli ./uli
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim AS runtime
RUN groupadd -r uli && useradd -r -g uli -d /app uli \
    && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /install /usr/local
WORKDIR /app
COPY uli ./uli
COPY schemas ./schemas
COPY parsers ./parsers
COPY pyproject.toml README.md ./
# Include the pre-built React UI so FastAPI can serve it at /ui
COPY ui/dist ./ui/dist
RUN mkdir -p /app/data /app/models && chown -R uli:uli /app
USER uli
ENV ULI_DATA_DIR=/app/data ULI_PARSERS_DIR=/app/parsers ULI_SCHEMAS_DIR=/app/schemas
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 CMD curl -sf http://localhost:8080/health || exit 1
CMD ["python", "-m", "uvicorn", "uli.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
